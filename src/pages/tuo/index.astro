---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const pageTitle = "TUO";
const posts = await getCollection("TUOPosts");
---

<Layout title={pageTitle}>
  <h1 class="page-title">{pageTitle}</h1>

  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/tuo/${post.data.slug}`}>{post.data.title.rendered}</a>
        </li>
      ))
    }
  </ul>
</Layout>
